# Variables lues par docker-compose.yml.
# Copier ce fichier en `.env` et remplir GROQ_API_KEY et SECRET_KEY avant le premier `docker compose up`.

# --- Obligatoire ---
GROQ_API_KEY=votre_clef_groq_ici
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire

# --- Optionnel ---
POSTGRES_PASSWORD=solidaire
VITE_API_URL=http://localhost:8000
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_MODEL=openai/gpt-oss-120b
